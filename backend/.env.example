# Backend application settings
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/qa_system_demo
JWT_SECRET=replace-with-a-long-random-local-secret

# Change to true only when intentionally running the demo seeder
SEED_DEMO_DATA=false

# Optional: set a local-only password if seeded accounts need to log in.
# Leave empty to generate a random password that is not displayed.
DEMO_SEED_PASSWORD=
