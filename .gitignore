
# Dependencies
backend/node_modules/
frontend/node_modules/

# Environment variables
backend/.env
frontend/.env
.env

# Environment files (ignore all variants)
backend/.env.*
frontend/.env.*
.env.*

# Keep example environment files
!backend/.env.example
!frontend/.env.example
!.env.example

# Build output
backend/dist/
frontend/dist/
frontend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache and coverage
.npm/
.cache/
coverage/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
